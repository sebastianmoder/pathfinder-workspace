{
  "dependencies": {
    "next": "16.4.4",
    "next-sitemap": "^4.2.3",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "@pathfinder/brand": "workspace:*",
    "@pathfinder/analytics": "workspace:*",
    "@pathfinder/config": "workspace:*"
  },
  "scripts": {
    "ensure:search-index": "if [ ! -f public/_pagefind/pagefind.js ]; then if [ -f .next/server/app/index.html ]; then pnpm run build:search-index; else pnpm build; fi; fi",
    "dev": "pnpm run ensure:search-index && NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--localstorage-file=.next/localstorage\" next",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--localstorage-file=.next/localstorage\" next build --webpack",
    "start": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--localstorage-file=.next/localstorage\" next start",
    "build:search-index": "rm -rf public/_pagefind public/fragment public/index public/pagefind* public/wasm.*.pagefind && pagefind --site .next/server/app --output-path public/_pagefind --root-selector \"[data-pagefind-body]\"",
    "postbuild": "next-sitemap && pnpm run build:search-index"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "pagefind": "^1.6.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.3"
  },
  "name": "@pathfinder/sage",
  "private": true,
  "packageManager": "pnpm@10.30.3"
}
